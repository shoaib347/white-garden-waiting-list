

# =========================================================================
# REQUIRED: PostgreSQL Database Connection
# =========================================================================
# You must provide a valid PostgreSQL connection string here to run the app.
# Example format: postgres://user:password@host:port/database
# If you don't have Postgres locally, you can create a free cloud database 
# at Neon.tech, Supabase, or Railway.
DATABASE_URL="postgres://postgres:password@localhost:5432/coal_db"

# =========================================================================
# System Port (Optional)
# =========================================================================
# The port where the application will run (default is 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
